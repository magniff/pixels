# Build output, at any level. Not `/target`: an integration test runs with its
# own crate as the working directory, so a relative path can create a nested one.
target/

# Screenshots are committed as PNG; the intermediate PPMs are not.
*.ppm

# Seeded at runtime by the app: a user's notes, not source.
/notes

# Model weights. Fetched with the curl line in the README, and a thousand
# times the size of everything else here.
/models
